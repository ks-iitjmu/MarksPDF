<?xml version="1.0" encoding="utf-8"?>
<!--
  A drawable that renders nothing.

  Android 12+ always draws a splash icon before any app code runs and masks it into a
  circle, which was cropping the logo. There's no flag to switch that off, so it is given
  this instead. It contains a real path covering the canvas with a fully transparent
  fill: a vector with no paths at all is treated as invalid and the system quietly falls
  back to the launcher icon, which is why the circle was still appearing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
